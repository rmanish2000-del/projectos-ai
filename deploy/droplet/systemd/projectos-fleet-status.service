[Unit]
Description=ProjectOS daily founder status snapshot
After=network-online.target projectos-reports-mount.service
Wants=network-online.target

[Service]
Type=oneshot
User=projectos
Group=projectos
WorkingDirectory=/opt/projectos/projectos-ai
Environment=HOME=/home/projectos
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=REPORTS_DIR=/mnt/gdrive/AGENT-REPORTS
Environment=INBOX_DIR=/home/projectos/gdrive-inbox
ExecStart=/opt/projectos/projectos-ai/deploy/droplet/fleet-status.sh
Nice=10
