[Unit]
Description=ProjectOS auto-signer sweep (one pass)
After=network-online.target projectos-inbox-mount.service
Wants=network-online.target projectos-inbox-mount.service

[Service]
Type=oneshot
User=projectos
Group=projectos
WorkingDirectory=/opt/projectos/projectos-ai
Environment=HOME=/home/projectos
Environment=PATH=/opt/projectos/venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/projectos/venv/bin/python -m projectos.infrastructure.inbox_auth auto-sign /home/projectos/gdrive-inbox
TimeoutStartSec=300
Nice=10

[Install]
WantedBy=multi-user.target
