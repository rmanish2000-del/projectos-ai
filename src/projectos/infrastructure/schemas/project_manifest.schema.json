{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://projectos.ai/schemas/v1/project_manifest.schema.json",
  "title": "ProjectOS workspace project manifest (project.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project"],
  "properties": {
    "schema_version": { "const": 1 },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "pack": { "type": "string", "minLength": 1 },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "adapter": { "enum": ["github", "local_git"] },
        "remote": { "type": "string", "minLength": 1 },
        "default_branch": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 }
      }
    }
  }
}
