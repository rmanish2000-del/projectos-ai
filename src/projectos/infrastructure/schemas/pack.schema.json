{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://projectos.ai/schemas/v1/pack.schema.json",
  "title": "ProjectOS project pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "version"],
  "properties": {
    "schema_version": { "const": 1 },
    "name": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "version": { "type": "string", "minLength": 1 },
    "domain": { "type": "string" },
    "vocabulary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "risk_flags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reviewed_work_types": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "protected_paths": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "governed_triggers_add": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "escalation_triggers_add": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "pipeline": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["phase", "templates"],
        "properties": {
          "phase": { "type": "string", "minLength": 1 },
          "templates": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
