__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
*.tmp

# Machine-local Claude Code permission grants; the tracked headless-wake
# allowlist is .claude/settings.json (RATIFICATION-WAKE-CADENCE).
/.claude/settings.local.json

# --- Workspace runtime-state (machine-local / generated; not corpus) ---
# Generated by `workspace init` / `add-project`; carries machine-specific absolute paths
# and per-machine registrations. The kernel's own `.projectos/` runtime state lives here
# too — but policy *rules* are tracked under /policies/ (POS-CC-CORPUS-FIX-004 D-002).
/.projectos/
/Workspace.yaml
# Project registrations (project.yaml) are the workspace REGISTRY, not runtime
# state: a registration correction that exists only on one disk is the SR-1
# exposure class. Registry tracked, everything else under /Projects/ ignored
# (THREE-KERNELS-RECONCILE, founder 'go' 2026-08-13).
/Projects/**
!/Projects/*/
!/Projects/*/project.yaml
